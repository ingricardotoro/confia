<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>com.confia</groupId>
    <artifactId>confia-api-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <relativePath>../pom.xml</relativePath>
  </parent>

  <artifactId>confia-api</artifactId>
  <packaging>jar</packaging>

  <name>CONFIA API</name>
  <description>
    Single deployable artifact with three entry points (admin, portal, worker), selected at
    startup by APP_PROFILE (ADR-0003, ADR-0013). Change 4 adds the ADR-0004 §Cumplimiento 2
    floating-point rules and the module-wide 80% JaCoCo coverage gate (BUNDLE, LINE and BRANCH);
    the first business module lands in this same change's PR B.
  </description>

  <dependencies>
    <dependency>
      <groupId>com.confia</groupId>
      <artifactId>confia-kernel</artifactId>
      <version>${project.version}</version>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>com.tngtech.archunit</groupId>
      <artifactId>archunit-junit5</artifactId>
      <version>${archunit.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.springframework.modulith</groupId>
      <artifactId>spring-modulith-core</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <!-- Coverage gate for this module (design.md decision 9; task 1.1 measured 89.7% line and
           84.6% branch coverage on com.confia.bootstrap alone, both above 80%, so the BUNDLE rule
           is declared in this pull request rather than deferred to PR B1). The prepare-agent and
           report executions are inherited unchanged from the parent pluginManagement; this
           execution only adds the check bound to verify (task 1.5). -->
      <plugin>
        <groupId>org.jacoco</groupId>
        <artifactId>jacoco-maven-plugin</artifactId>
        <executions>
          <execution>
            <id>jacoco-check</id>
            <phase>verify</phase>
            <goals>
              <goal>check</goal>
            </goals>
            <configuration>
              <rules>
                <rule>
                  <element>BUNDLE</element>
                  <limits>
                    <limit>
                      <counter>LINE</counter>
                      <value>COVEREDRATIO</value>
                      <minimum>0.80</minimum>
                    </limit>
                    <limit>
                      <counter>BRANCH</counter>
                      <value>COVEREDRATIO</value>
                      <minimum>0.80</minimum>
                    </limit>
                  </limits>
                </rule>
              </rules>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
