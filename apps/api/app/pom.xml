<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>com.confia</groupId>
    <artifactId>confia-api-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <relativePath>../pom.xml</relativePath>
  </parent>

  <artifactId>confia-api</artifactId>
  <packaging>jar</packaging>

  <name>CONFIA API</name>
  <description>
    Single deployable artifact with three entry points (admin, portal, worker), selected at
    startup by APP_PROFILE (ADR-0003, ADR-0013). Change 4 adds the ADR-0004 §Cumplimiento 2
    floating-point rules and the module-wide 80% JaCoCo coverage gate (BUNDLE, LINE and BRANCH);
    the first business module lands in this same change's PR B.
  </description>

  <dependencies>
    <dependency>
      <groupId>com.confia</groupId>
      <artifactId>confia-kernel</artifactId>
      <version>${project.version}</version>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>

    <!-- Data access (ADR-0015): jOOQ open source, Flyway and the PostgreSQL JDBC driver. No
         version on any of the three: managed by the Spring Boot 4.1.1 BOM (jOOQ 3.21.7, Flyway
         12.4.0, org.postgresql:postgresql 42.7.13 — design.md section 2, evidence table). -->
    <!-- DataSourceAutoConfiguration, FlywayAutoConfiguration and TransactionAwareDataSourceProxy
         (task 1.5's explicit DSLContext bean, apply-progress.md S1.6) all live in spring-jdbc,
         which nothing else in this module pulls in transitively: spring-boot-starter-web depends
         on spring-web/spring-webmvc, not spring-jdbc. -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-jdbc</artifactId>
    </dependency>
    <dependency>
      <groupId>org.jooq</groupId>
      <artifactId>jooq</artifactId>
    </dependency>
    <dependency>
      <groupId>org.flywaydb</groupId>
      <artifactId>flyway-core</artifactId>
    </dependency>
    <dependency>
      <groupId>org.flywaydb</groupId>
      <artifactId>flyway-database-postgresql</artifactId>
    </dependency>
    <!-- Spring Boot 4.x split its once-monolithic spring-boot-autoconfigure jar into one module
         per feature (verified by inspecting spring-boot-autoconfigure-4.1.1.jar: 258 classes
         total, none under org/springframework/boot/autoconfigure/{jdbc,flyway,jooq}). Flyway's
         FlywayAutoConfiguration now lives in this separate artifact and is not pulled in
         transitively by flyway-core or by spring-boot-starter-jdbc; jOOQ has no equivalent
         module at all (apply-progress.md task 1.1/1.5, S1.6 and its follow-up). -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-flyway</artifactId>
    </dependency>
    <dependency>
      <groupId>org.postgresql</groupId>
      <artifactId>postgresql</artifactId>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
    <!-- Testcontainers 2.x (design.md decision 3): the module names changed from the 1.x line
         (postgresql, junit-jupiter) to testcontainers-postgresql and testcontainers-junit-jupiter;
         both are managed by the Spring Boot 4.1.1 BOM under their new names (design.md section 2
         evidence table; confirmed again by task 1.3's dependencyConvergence run: no version needed
         here). -->
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>testcontainers-postgresql</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>testcontainers-junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>com.tngtech.archunit</groupId>
      <artifactId>archunit-junit5</artifactId>
      <version>${archunit.version}</version>
      <scope>test</scope>
    </dependency>
    <!-- Property-based cross-check between the canonical serializer's PL/pgSQL and Java
         implementations (design.md decision 6; task 1.1, sonda S13). Version managed by the
         parent's dependencyManagement (apps/api/pom.xml), same as kernel/pom.xml already declares
         it: no version pinned here. -->
    <dependency>
      <groupId>net.jqwik</groupId>
      <artifactId>jqwik</artifactId>
      <scope>test</scope>
    </dependency>
    <!-- Argon2id over Bouncy Castle directly (design.md decision 6; sonda S2,
         apply-progress.md task 2.1): spring-security-crypto's Argon2PasswordEncoder has a single
         five-int constructor and no secret parameter, confirmed with javap, while
         org.bouncycastle.crypto.params.Argon2Parameters$Builder exposes withSecret(byte[]), which
         docs/03-seguridad.md §4.1 requires to apply the pepper. Compile scope: consumed by
         production classes under com.confia.identity.infrastructure
         (BouncyCastleArgon2PasswordHasher, Argon2PhcCodec). Version managed in the parent's
         dependencyManagement (apps/api/pom.xml). Not in maven-enforcer-plugin's banned-dependency
         list (apps/api/pom.xml bannedDependencies). -->
    <dependency>
      <groupId>org.bouncycastle</groupId>
      <artifactId>bcprov-jdk18on</artifactId>
    </dependency>
    <!-- springdoc-openapi (frontend-monorepo-and-contracts-pipeline, design.md decisions 1 to 3):
         generates the OpenAPI 3.1 document of each process from its real entry point. The
         endpoint and Swagger UI are off by default and turned on only by application-local.yml
         and application-preprod.yml. Version managed in the parent's dependencyManagement. -->
    <dependency>
      <groupId>org.springdoc</groupId>
      <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
    </dependency>
    <!-- @NamedInterface (ADR-0022; design.md decision 12) is org.springframework.modulith.
         NamedInterface, which lives in spring-modulith-api, NOT in spring-modulith-core (S1b probe,
         apply-progress.md): a same-simple-name org.springframework.modulith.core.NamedInterface
         exists too, but it is a model class, not the annotation. Declared at compile scope, with no
         explicit <scope> element, because two production package-info.java files
         (com.confia.shared.security, com.confia.shared.audit) carry the annotation and must compile
         with it on the classpath. spring-modulith-api does not depend on ArchUnit, unlike
         spring-modulith-core below, so promoting only this artifact never puts a test-only library
         in front of production classes (sonda S6 confirms dependencyConvergence stays green). -->
    <dependency>
      <groupId>org.springframework.modulith</groupId>
      <artifactId>spring-modulith-api</artifactId>
    </dependency>
    <!-- ApplicationModules.verify() itself (SpringModulithVerificationTest) stays test-scoped: it
         pulls in ArchUnit transitively, which has no business on the production classpath. -->
    <dependency>
      <groupId>org.springframework.modulith</groupId>
      <artifactId>spring-modulith-core</artifactId>
      <scope>test</scope>
    </dependency>
    <!-- pitest-junit5-plugin (from its 1.2 line on) requires junit-platform-launcher on the test
         classpath to discover Jupiter's tests (same reason as kernel's own dependency; version
         managed by junit-bom). -->
    <dependency>
      <groupId>org.junit.platform</groupId>
      <artifactId>junit-platform-launcher</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <!-- Single source of truth for the PostgreSQL image (ADR-0015 rule 1; design.md decision 3;
         task 1.6). Filtering is restricted to confia-build.properties alone. Declared as two
         passes over the SAME directory, in order, rather than an <excludes> on the first pass:
         SuppressionCitesAdrTest's JaCoCo-class-exclusion pattern matches ANY <exclude>...</exclude>
         with no colon, anywhere under apps/api, and would misidentify a plain
         maven-resources-plugin exclude as an uncited JaCoCo suppression (confirmed by a real run,
         apply-progress.md task 1.7). The first pass copies everything under src/test/resources
         unfiltered, including the raw confia-build.properties; the second pass, restricted by
         <includes> to that one file, reprocesses it filtered and overwrites the raw copy — so no
         other file (in particular no ${...} in an SQL script such as the beforeMigrate__ callback)
         is ever touched by filtering. -->
    <testResources>
      <testResource>
        <directory>src/test/resources</directory>
        <filtering>false</filtering>
      </testResource>
      <testResource>
        <directory>src/test/resources</directory>
        <filtering>true</filtering>
        <includes>
          <include>confia-build.properties</include>
        </includes>
      </testResource>
    </testResources>
    <plugins>
      <!-- Coverage gate for this module (design.md decision 9; task 1.1 measured 89.7% line and
           84.6% branch coverage on com.confia.bootstrap alone, both above 80%, so the BUNDLE rule
           is declared in this pull request rather than deferred to PR B1). The prepare-agent and
           report executions are inherited unchanged from the parent pluginManagement; this
           execution only adds the check bound to verify (task 1.5). -->
      <plugin>
        <groupId>org.jacoco</groupId>
        <artifactId>jacoco-maven-plugin</artifactId>
        <executions>
          <execution>
            <id>jacoco-report</id>
            <configuration>
              <!-- ADR-0021 "Cumplimiento y verificación" point 3: the generated jOOQ package
                   never has an author or a test of its own; excluded here so this report only
                   measures code a person actually wrote. -->
              <excludes>
                <exclude>confia/generated/**</exclude>
              </excludes>
            </configuration>
          </execution>
          <execution>
            <id>jacoco-check</id>
            <phase>verify</phase>
            <goals>
              <goal>check</goal>
            </goals>
            <configuration>
              <!-- ADR-0021 "Cumplimiento y verificación" point 3: same exclusion, applied to the
                   coverage gate itself, not only to the report above. -->
              <excludes>
                <exclude>confia/generated/**</exclude>
              </excludes>
              <rules>
                <rule>
                  <element>BUNDLE</element>
                  <limits>
                    <limit>
                      <counter>LINE</counter>
                      <value>COVEREDRATIO</value>
                      <minimum>0.80</minimum>
                    </limit>
                    <limit>
                      <counter>BRANCH</counter>
                      <value>COVEREDRATIO</value>
                      <minimum>0.80</minimum>
                    </limit>
                  </limits>
                </rule>
                <!-- 95% line+branch coverage on every business module's domain package (task 2.7;
                     design.md decision 9). The double wildcard reaches com.confia.<module>.domain
                     and com.confia.<module>.domain.<sub>, so a future module's domain is covered
                     without touching this POM again. -->
                <rule>
                  <element>PACKAGE</element>
                  <includes>
                    <include>com.confia.*.domain</include>
                    <include>com.confia.*.domain.*</include>
                  </includes>
                  <limits>
                    <limit>
                      <counter>LINE</counter>
                      <value>COVEREDRATIO</value>
                      <minimum>0.95</minimum>
                    </limit>
                    <limit>
                      <counter>BRANCH</counter>
                      <value>COVEREDRATIO</value>
                      <minimum>0.95</minimum>
                    </limit>
                  </limits>
                </rule>
                <!-- 95% line+branch coverage on the canonical serialization package (design.md
                     decision 12; task 1.9). Pure, high-proof-value logic that does not encode with
                     com.confia.*.domain (it deliberately lives outside every layer, decision 1), so
                     it needs its own explicit rule rather than piggybacking on the one above.
                     com.confia.shared.audit carries no class yet in this PR — its first class
                     (CanonicalAuditRowSerializer) lands in PR B3a — so this rule is declared two
                     cuts ahead of having anything to measure (design.md §5 does not flag that gap;
                     task 1.9's own text calls it out for whoever reads this next: if an empty
                     PACKAGE rule ever fails the build instead of passing vacuously, that is a
                     discrepancy with the design to report, not a threshold to relax or a rule to
                     move). Uses only <includes>, never <excludes> (probe S10,
                     apply-progress.md task 1.1): SuppressionCitesAdrTest's uncited-exclusion
                     scanner only matches <exclude>, so this rule needs no ADR citation. -->
                <rule>
                  <element>PACKAGE</element>
                  <includes>
                    <include>com.confia.shared.audit</include>
                  </includes>
                  <limits>
                    <limit>
                      <counter>LINE</counter>
                      <value>COVEREDRATIO</value>
                      <minimum>0.95</minimum>
                    </limit>
                    <limit>
                      <counter>BRANCH</counter>
                      <value>COVEREDRATIO</value>
                      <minimum>0.95</minimum>
                    </limit>
                  </limits>
                </rule>
              </rules>
            </configuration>
          </execution>
        </executions>
      </plugin>

      <!-- jOOQ code generation over a Testcontainers-managed PostgreSQL, generate-sources phase
           (ADR-0015 rule 2; design.md decision 1, route A). Version comes from the parent's
           pluginManagement (task 1.2); this execution overrides the plugin's OWN pinned
           dependencies. Without this override the plugin uses Testcontainers 1.19.1, which cannot
           reach Docker Desktop on this machine, and jOOQ 3.18.3, which cannot introspect a
           PostgreSQL 18 catalog (getRelations/getPrimaryKey fails with "Field (key_seq) is not
           contained in Row"); both were confirmed with a real run outside the repository tree
           (apply-progress.md task 1.1, S1.3). No skip flag exists for this execution: ADR-0008
           forbids disabling a gate with a flag, and a skipped generation would silently reopen the
           exact drift ADR-0015 rule 2 exists to prevent. -->
      <plugin>
        <groupId>org.testcontainers</groupId>
        <artifactId>testcontainers-jooq-codegen-maven-plugin</artifactId>
        <dependencies>
          <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers</artifactId>
            <version>2.0.5</version>
          </dependency>
          <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers-postgresql</artifactId>
            <version>2.0.5</version>
          </dependency>
          <dependency>
            <groupId>org.jooq</groupId>
            <artifactId>jooq-codegen</artifactId>
            <version>3.21.7</version>
          </dependency>
          <dependency>
            <groupId>org.jooq</groupId>
            <artifactId>jooq-meta</artifactId>
            <version>3.21.7</version>
          </dependency>
        </dependencies>
        <executions>
          <execution>
            <id>generate-jooq-sources</id>
            <phase>generate-sources</phase>
            <goals>
              <goal>generate</goal>
            </goals>
          </execution>
        </executions>
        <configuration>
          <database>
            <type>POSTGRES</type>
            <containerImage>${confia.postgres.image}</containerImage>
          </database>
          <!-- Two Flyway locations (design.md decision 5): the real migrations, applied exactly
               as they would be in production, and a generation-only location whose
               beforeMigrate__ callback creates the five roles as NOLOGIN, with no password, only
               so GRANT statements in the real migrations have a role to name. Verified with a real
               two-location run outside the repository tree (apply-progress.md task 1.1, S1.4).
               Both locations are "filesystem:", never "classpath:": generate-sources runs before
               process-resources copies src/main/resources into target/classes, so a
               "classpath:db/migration" location would scan an empty or stale directory and Flyway
               would silently apply nothing (confirmed with a real "No migrations found" run,
               apply-progress.md task 1.7). Both paths are absolute, anchored on
               ${project.basedir}: a relative "filesystem:" path resolves against the JVM's own
               working directory, which stays wherever `mvn` was launched from across every module
               in a reactor build, not this module's own basedir (also confirmed with a real
               "Skipping filesystem location ... (not found)" run when building from apps/api with
               "-pl app", task 1.7). -->
          <flyway>
            <locations>filesystem:${project.basedir}/src/main/resources/db/migration,filesystem:${project.basedir}/src/test/resources/db/codegen</locations>
          </flyway>
          <jooq>
            <generator>
              <database>
                <name>org.jooq.meta.postgres.PostgresDatabase</name>
                <inputSchema>public</inputSchema>
                <excludes>flyway_schema_history</excludes>
                <!-- jOOQ 3.21 has no built-in mapping for PostgreSQL's inet: without this, the
                     generated field type is the deprecated, unusable Object (sonda S9, task 5.1;
                     design.md §10). shared_audit_log.source_ip is the only inet column today. -->
                <forcedTypes>
                  <forcedType>
                    <name>VARCHAR</name>
                    <includeTypes>inet</includeTypes>
                  </forcedType>
                </forcedTypes>
              </database>
              <generate>
                <!-- No Tables/Keys/Indexes umbrella classes: every reference to a table names its
                     own generated type, which is what makes the table-ownership-by-module rule
                     (task 3.2) verifiable at all (ADR-0021, decision 2, point 2). -->
                <globalObjectReferences>false</globalObjectReferences>
              </generate>
              <target>
                <!-- Outside com.confia on purpose (ADR-0021, decision D3): ArchUnit's and Spring
                     Modulith's own "com.confia" import never reaches this package, so neither
                     needs a per-case exception for generated code. Never committed: target/ is
                     already git-ignored. -->
                <packageName>confia.generated.jooq</packageName>
                <directory>target/generated-sources/jooq</directory>
              </target>
            </generator>
          </jooq>
        </configuration>
      </plugin>

      <!-- Mutation adhesion (design.md decision 9): app opts in by declaring this plugin with its
           own targetClasses/targetTests, scoped to every business module's domain package (the
           same double-wildcard reasoning as the JaCoCo PACKAGE rule above); version, the plugin
           dependency on pitest-junit5-plugin and the mutationCoverage execution are managed in the
           parent (same pattern as kernel/pom.xml). -->
      <plugin>
        <groupId>org.pitest</groupId>
        <artifactId>pitest-maven</artifactId>
        <configuration>
          <targetClasses>
            <param>com.confia.*.domain.*</param>
          </targetClasses>
          <targetTests>
            <param>com.confia.*.domain.*</param>
          </targetTests>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
