<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>com.confia</groupId>
    <artifactId>confia-api-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <relativePath>../pom.xml</relativePath>
  </parent>

  <artifactId>confia-kernel</artifactId>
  <packaging>jar</packaging>

  <name>CONFIA Kernel</name>
  <description>
    Compilation boundary with zero dependencies outside the JDK (ADR-0002, ADR-0013). Money,
    identifiers and the base domain error live here once a change needs them; no business rule
    ever lives in this module. Test-scope dependencies (JUnit, AssertJ) are allowed: only
    compile/runtime/provided dependencies are banned by the enforcer execution below.
  </description>

  <dependencies>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.assertj</groupId>
      <artifactId>assertj-core</artifactId>
      <scope>test</scope>
    </dependency>
    <!-- Property-based tests (design.md decision 5 of the proposal). Test scope only:
         enforce-kernel-purity below never sees it. -->
    <dependency>
      <groupId>net.jqwik</groupId>
      <artifactId>jqwik</artifactId>
      <scope>test</scope>
    </dependency>
    <!-- pitest-junit5-plugin (from its 1.2 line on) requires junit-platform-launcher on the test
         classpath to discover jqwik's and Jupiter's tests (design.md, "Por confirmar durante la
         implementación", point 4; version managed by junit-bom). -->
    <dependency>
      <groupId>org.junit.platform</groupId>
      <artifactId>junit-platform-launcher</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <!--
        Kernel purity (ADR-0002, ADR-0013): no compile/runtime/provided dependency may exist in
        this module, only test-scope. This is what makes "kernel importa Spring" fail the build
        instead of merely violating a convention nobody enforces.
      -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-enforcer-plugin</artifactId>
        <executions>
          <execution>
            <id>enforce-kernel-purity</id>
            <phase>validate</phase>
            <goals>
              <goal>enforce</goal>
            </goals>
            <configuration>
              <rules>
                <bannedDependencies>
                  <excludes>
                    <exclude>*:*:*:*:compile</exclude>
                    <exclude>*:*:*:*:runtime</exclude>
                    <exclude>*:*:*:*:provided</exclude>
                    <exclude>*:*:*:*:system</exclude>
                  </excludes>
                  <message>
                    apps/api/kernel must not depend on anything outside the JDK (ADR-0002,
                    ADR-0013). Only test-scope dependencies are allowed in this module.
                  </message>
                </bannedDependencies>
              </rules>
              <fail>true</fail>
            </configuration>
          </execution>
        </executions>
      </plugin>

      <!-- Coverage gate for this module (design.md decision 8): BUNDLE-level LINE and BRANCH
           coverage must both be at or above 95 %. Version and the prepare-agent/report executions
           are managed in the parent; this execution only adds the check bound to verify. -->
      <plugin>
        <groupId>org.jacoco</groupId>
        <artifactId>jacoco-maven-plugin</artifactId>
        <executions>
          <execution>
            <id>jacoco-check</id>
            <phase>verify</phase>
            <goals>
              <goal>check</goal>
            </goals>
            <configuration>
              <rules>
                <rule>
                  <element>BUNDLE</element>
                  <limits>
                    <limit>
                      <counter>LINE</counter>
                      <value>COVEREDRATIO</value>
                      <minimum>0.95</minimum>
                    </limit>
                    <limit>
                      <counter>BRANCH</counter>
                      <value>COVEREDRATIO</value>
                      <minimum>0.95</minimum>
                    </limit>
                  </limits>
                </rule>
              </rules>
            </configuration>
          </execution>
        </executions>
      </plugin>

      <!-- Mutation adhesion (design.md decision 9): kernel opts in by declaring this plugin with
           its own targetClasses/targetTests; version, the plugin dependency on
           pitest-junit5-plugin and the mutationCoverage execution are managed in the parent. -->
      <plugin>
        <groupId>org.pitest</groupId>
        <artifactId>pitest-maven</artifactId>
        <configuration>
          <targetClasses>
            <param>com.confia.kernel.*</param>
          </targetClasses>
          <targetTests>
            <param>com.confia.kernel.*</param>
          </targetTests>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
