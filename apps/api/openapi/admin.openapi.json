{
  "components" : {
    "schemas" : {
      "AuthenticatedSessionResponse" : {
        "properties" : {
          "accessToken" : {
            "description" : "The access token, for the Authorization header",
            "format" : "password",
            "type" : "string"
          },
          "accessTokenExpiresAt" : {
            "description" : "When the access token stops being valid",
            "format" : "date-time",
            "type" : "string"
          },
          "idleExpiresAt" : {
            "description" : "When the session becomes idle if it is not used again",
            "format" : "date-time",
            "type" : "string"
          },
          "sessionExpiresAt" : {
            "description" : "The absolute end of the session, whatever its use",
            "format" : "date-time",
            "type" : "string"
          },
          "status" : {
            "description" : "Always authenticated: a session was started",
            "enum" : [ "authenticated" ],
            "type" : "string"
          }
        },
        "required" : [ "accessToken", "accessTokenExpiresAt", "idleExpiresAt", "sessionExpiresAt", "status" ],
        "type" : "object"
      },
      "CurrentSessionResponse" : {
        "properties" : {
          "accessTokenExpiresAt" : {
            "description" : "When the access token stops being valid",
            "format" : "date-time",
            "type" : "string"
          },
          "accountId" : {
            "description" : "Opaque identifier of the staff account",
            "format" : "uuid",
            "type" : "string"
          },
          "authenticationMethods" : {
            "description" : "How the staff member authenticated, as the amr values of the token",
            "items" : {
              "type" : "string"
            },
            "type" : "array"
          },
          "idleExpiresAt" : {
            "description" : "When the session becomes idle if it is not used again",
            "format" : "date-time",
            "type" : "string"
          },
          "institutionId" : {
            "description" : "Identifier of the institution of the session",
            "format" : "uuid",
            "type" : "string"
          },
          "sessionExpiresAt" : {
            "description" : "The absolute end of the session, whatever its use",
            "format" : "date-time",
            "type" : "string"
          },
          "sessionId" : {
            "description" : "Identifier of the session",
            "format" : "uuid",
            "type" : "string"
          }
        },
        "required" : [ "accessTokenExpiresAt", "accountId", "authenticationMethods", "idleExpiresAt", "institutionId", "sessionExpiresAt", "sessionId" ],
        "type" : "object"
      },
      "EnrollmentResponse" : {
        "properties" : {
          "recoveryCodes" : {
            "description" : "The ten recovery codes. Shown once",
            "items" : {
              "type" : "string"
            },
            "type" : "array"
          },
          "secret" : {
            "description" : "The TOTP secret in base32 without padding, for the authenticator application. Shown once",
            "format" : "password",
            "maxLength" : 32,
            "minLength" : 32,
            "pattern" : "^[A-Z2-7]{32}$",
            "type" : "string"
          }
        },
        "required" : [ "recoveryCodes", "secret" ],
        "type" : "object"
      },
      "LoginRequest" : {
        "properties" : {
          "identifier" : {
            "description" : "The identifier of the staff account, as typed",
            "maxLength" : 320,
            "minLength" : 0,
            "type" : "string"
          },
          "password" : {
            "description" : "The password, as typed",
            "format" : "password",
            "maxLength" : 1024,
            "minLength" : 0,
            "type" : "string"
          }
        },
        "required" : [ "identifier", "password" ],
        "type" : "object"
      },
      "LoginResponse" : {
        "discriminator" : {
          "mapping" : {
            "authenticated" : "#/components/schemas/AuthenticatedSessionResponse",
            "second-factor-enrollment-required" : "#/components/schemas/SecondFactorPendingResponse",
            "second-factor-required" : "#/components/schemas/SecondFactorPendingResponse"
          },
          "propertyName" : "status"
        },
        "oneOf" : [ {
          "$ref" : "#/components/schemas/AuthenticatedSessionResponse"
        }, {
          "$ref" : "#/components/schemas/SecondFactorPendingResponse"
        } ]
      },
      "Money" : {
        "description" : "A monetary amount as it travels over the API: never a JSON number",
        "properties" : {
          "amount" : {
            "description" : "Decimal amount with up to four decimals, as a string",
            "pattern" : "^-?\\d{1,10}(\\.\\d{1,4})?$",
            "type" : "string"
          },
          "currency" : {
            "description" : "ISO 4217 currency code",
            "pattern" : "^[A-Z]{3}$",
            "type" : "string"
          }
        },
        "required" : [ "amount", "currency" ],
        "type" : "object"
      },
      "ProblemDetail" : {
        "description" : "An error response in RFC 9457 Problem Details format",
        "properties" : {
          "detail" : {
            "type" : "string"
          },
          "errors" : {
            "description" : "The violated constraints of a validation failure, at most fifty",
            "items" : {
              "properties" : {
                "field" : {
                  "description" : "Path of the field in the request",
                  "type" : "string"
                },
                "reason" : {
                  "description" : "The constraint that was broken, in kebab case",
                  "type" : "string"
                }
              },
              "required" : [ "field", "reason" ],
              "type" : "object"
            },
            "type" : "array"
          },
          "instance" : {
            "format" : "uri",
            "type" : "string"
          },
          "status" : {
            "format" : "int32",
            "type" : "integer"
          },
          "title" : {
            "type" : "string"
          },
          "traceId" : {
            "description" : "Identifier of the request's trace, to correlate with logs",
            "type" : "string"
          },
          "type" : {
            "format" : "uri",
            "type" : "string"
          }
        },
        "type" : "object"
      },
      "SecondFactorPendingResponse" : {
        "properties" : {
          "secondFactorToken" : {
            "description" : "The restricted token, for the routes of the second factor only",
            "format" : "password",
            "type" : "string"
          },
          "secondFactorTokenExpiresAt" : {
            "description" : "When the restricted token stops being valid",
            "format" : "date-time",
            "type" : "string"
          },
          "status" : {
            "description" : "Whether the account must present a code or must enroll a second factor",
            "enum" : [ "second-factor-required", "second-factor-enrollment-required" ],
            "type" : "string"
          }
        },
        "required" : [ "secondFactorToken", "secondFactorTokenExpiresAt", "status" ],
        "type" : "object"
      },
      "SecondFactorVerificationRequest" : {
        "properties" : {
          "code" : {
            "description" : "The current code of the authenticator application. Exactly one of code and recoveryCode is sent",
            "maxLength" : 64,
            "minLength" : 0,
            "type" : "string"
          },
          "recoveryCode" : {
            "description" : "A recovery code of the enrollment. Exactly one of code and recoveryCode is sent; the first verification of a credential does not accept it",
            "maxLength" : 64,
            "minLength" : 0,
            "type" : "string"
          }
        },
        "type" : "object"
      }
    },
    "securitySchemes" : {
      "bearerAuth" : {
        "bearerFormat" : "JWT",
        "description" : "Access token of a staff session",
        "scheme" : "bearer",
        "type" : "http"
      }
    }
  },
  "info" : {
    "title" : "CONFIA admin API",
    "version" : "v1"
  },
  "openapi" : "3.1.0",
  "paths" : {
    "/api/v1/auth/mfa/enrollments" : {
      "post" : {
        "description" : "Takes the restricted token of the login for the enrollment (mfa-enroll) and no body. Creates the credential, or replaces the secret of a credential that was never verified and retires its recovery codes, and answers with the secret in base32 and ten recovery codes, shown once. A verified credential is never replaced. The enrollment activates nothing and opens no session.",
        "operationId" : "enrollSecondFactor",
        "responses" : {
          "201" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/EnrollmentResponse"
                }
              }
            },
            "description" : "The credential was written"
          },
          "401" : {
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ProblemDetail"
                }
              }
            },
            "description" : "No credential (authentication-required), or a restricted token that is expired (token-expired) or not accepted by this route (token-invalid)",
            "headers" : {
              "WWW-Authenticate" : {
                "description" : "The Bearer challenge",
                "schema" : {
                  "type" : "string"
                },
                "style" : "simple"
              }
            }
          },
          "403" : {
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ProblemDetail"
                }
              }
            },
            "description" : "The Origin is missing or not allowed (csrf-invalid)"
          },
          "409" : {
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ProblemDetail"
                }
              }
            },
            "description" : "The credential is already verified (mfa-already-enrolled)"
          },
          "429" : {
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ProblemDetail"
                }
              }
            },
            "description" : "Too many requests from this address (too-many-requests)",
            "headers" : {
              "Retry-After" : {
                "description" : "Seconds to wait",
                "schema" : {
                  "type" : "integer"
                },
                "style" : "simple"
              }
            }
          },
          "503" : {
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ProblemDetail"
                }
              }
            },
            "description" : "No capacity to count the client (capacity-exceeded)"
          }
        },
        "security" : [ {
          "bearerAuth" : [ ]
        } ],
        "summary" : "Enrolls the TOTP second factor, or replaces the secret of one never verified",
        "tags" : [ "auth-mfa" ]
      }
    },
    "/api/v1/auth/mfa/verifications" : {
      "post" : {
        "description" : "Takes the restricted token of the login (mfa-verify, or mfa-enroll for the first verification) and exactly one of a TOTP code or a recovery code. The first verification of a credential accepts only a TOTP code, activates the credential and ends the other sessions of the account. Answers with a session and the two cookies, or with second-factor-invalid, which does not say why the proof was refused.",
        "operationId" : "completeSecondFactor",
        "requestBody" : {
          "content" : {
            "application/json" : {
              "schema" : {
                "$ref" : "#/components/schemas/SecondFactorVerificationRequest"
              }
            }
          },
          "required" : true
        },
        "responses" : {
          "200" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/AuthenticatedSessionResponse"
                }
              }
            },
            "description" : "A session was started",
            "headers" : {
              "Set-Cookie" : {
                "description" : "The session cookie and the CSRF cookie, two headers",
                "schema" : {
                  "type" : "string"
                },
                "style" : "simple"
              }
            }
          },
          "400" : {
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ProblemDetail"
                }
              }
            },
            "description" : "The body is not valid, or does not carry exactly one proof (validation-failed)"
          },
          "401" : {
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ProblemDetail"
                }
              }
            },
            "description" : "No credential (authentication-required), a restricted token that is expired (token-expired) or not accepted by this route (token-invalid), or a proof that was not accepted (second-factor-invalid)",
            "headers" : {
              "WWW-Authenticate" : {
                "description" : "The Bearer challenge",
                "schema" : {
                  "type" : "string"
                },
                "style" : "simple"
              }
            }
          },
          "403" : {
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ProblemDetail"
                }
              }
            },
            "description" : "The Origin is missing or not allowed (csrf-invalid)"
          },
          "415" : {
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ProblemDetail"
                }
              }
            },
            "description" : "The content type is not JSON (unsupported-media-type)"
          },
          "429" : {
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ProblemDetail"
                }
              }
            },
            "description" : "Too many requests from this address (too-many-requests)",
            "headers" : {
              "Retry-After" : {
                "description" : "Seconds to wait",
                "schema" : {
                  "type" : "integer"
                },
                "style" : "simple"
              }
            }
          },
          "503" : {
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ProblemDetail"
                }
              }
            },
            "description" : "No capacity to count the client or to hold one more waiting request (capacity-exceeded)"
          }
        },
        "security" : [ {
          "bearerAuth" : [ ]
        } ],
        "summary" : "Verifies a second-factor proof and starts the session",
        "tags" : [ "auth-mfa" ]
      }
    },
    "/api/v1/auth/sessions" : {
      "post" : {
        "description" : "Starts a session (status authenticated, with the session cookie and the CSRF cookie) or, when the account owes a second factor, answers with a restricted token and no cookie (status second-factor-required or second-factor-enrollment-required). Needs no credential, an allowed Origin and a JSON body. The answer for a wrong password is the same for an account that exists and one that does not.",
        "operationId" : "logIn",
        "requestBody" : {
          "content" : {
            "application/json" : {
              "schema" : {
                "$ref" : "#/components/schemas/LoginRequest"
              }
            }
          },
          "required" : true
        },
        "responses" : {
          "200" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/LoginResponse"
                }
              }
            },
            "description" : "A session was started, or a second factor is owed",
            "headers" : {
              "Set-Cookie" : {
                "description" : "Only with status authenticated: the session cookie and the CSRF cookie, two headers",
                "schema" : {
                  "type" : "string"
                },
                "style" : "simple"
              }
            }
          },
          "400" : {
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ProblemDetail"
                }
              }
            },
            "description" : "The body is not valid (validation-failed)"
          },
          "401" : {
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ProblemDetail"
                }
              }
            },
            "description" : "The credentials were not accepted (authentication-failed)",
            "headers" : {
              "WWW-Authenticate" : {
                "description" : "The Bearer challenge",
                "schema" : {
                  "type" : "string"
                },
                "style" : "simple"
              }
            }
          },
          "403" : {
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ProblemDetail"
                }
              }
            },
            "description" : "The Origin is missing or not allowed (csrf-invalid)"
          },
          "415" : {
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ProblemDetail"
                }
              }
            },
            "description" : "The content type is not JSON (unsupported-media-type)"
          },
          "429" : {
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ProblemDetail"
                }
              }
            },
            "description" : "Too many requests from this address (too-many-requests)",
            "headers" : {
              "Retry-After" : {
                "description" : "Seconds to wait",
                "schema" : {
                  "type" : "integer"
                },
                "style" : "simple"
              }
            }
          },
          "503" : {
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ProblemDetail"
                }
              }
            },
            "description" : "No capacity to count the client or to hold one more waiting request (capacity-exceeded)"
          }
        },
        "summary" : "Logs in with an identifier and a password",
        "tags" : [ "auth-sessions" ]
      }
    },
    "/api/v1/auth/sessions/current" : {
      "get" : {
        "description" : "Returns the session the access token belongs to and when each of its three ends comes. Needs an access token of a live session and no permission of any role. Reads only: it does not extend the session.",
        "operationId" : "getCurrentSession",
        "responses" : {
          "200" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/CurrentSessionResponse"
                }
              }
            },
            "description" : "The session of the token"
          },
          "401" : {
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ProblemDetail"
                }
              }
            },
            "description" : "No credential (authentication-required), or a credential that cannot be accepted: expired (token-expired), or altered, restricted, of a revoked or unknown session (token-invalid). Always with WWW-Authenticate.",
            "headers" : {
              "WWW-Authenticate" : {
                "description" : "The Bearer challenge; with error=\"invalid_token\" when a credential was presented and rejected",
                "schema" : {
                  "type" : "string"
                },
                "style" : "simple"
              }
            }
          },
          "500" : {
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ProblemDetail"
                }
              }
            },
            "description" : "Unexpected failure (internal-error)"
          }
        },
        "security" : [ {
          "bearerAuth" : [ ]
        } ],
        "summary" : "Reads the session of the bearer token",
        "tags" : [ "auth-sessions" ]
      }
    }
  }
}
