<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>com.confia</groupId>
  <artifactId>confia-api-parent</artifactId>
  <version>0.1.0-SNAPSHOT</version>
  <packaging>pom</packaging>

  <name>CONFIA API Parent</name>
  <description>
    Reactor parent for the CONFIA backend. Centralizes the Java version, the Spring Boot 4.1 BOM
    and every build-integrity verification (maven-enforcer-plugin, Surefire, Failsafe). No module
    declares its own plugin version: everything is managed here so a rule cannot silently drift
    between modules.
  </description>

  <modules>
    <module>kernel</module>
    <module>app</module>
  </modules>

  <properties>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>

    <!-- Single source of truth for the Java version (ADR-0013). -->
    <java.version>25</java.version>
    <maven.compiler.release>${java.version}</maven.compiler.release>

    <spring-boot.version>4.1.1</spring-boot.version>
    <spring-modulith.version>2.1.1</spring-modulith.version>
    <!--
      Declares the archunit-junit5* wrapper artifacts only (app/pom.xml). It does NOT pin the
      plain "com.tngtech.archunit:archunit" core artifact: see the dependencyManagement entry
      below for why that one is declared separately (verify-report.md W6).
    -->
    <archunit.version>1.5.0</archunit.version>

    <maven-enforcer-plugin.version>3.6.3</maven-enforcer-plugin.version>
    <maven-compiler-plugin.version>3.16.0</maven-compiler-plugin.version>
    <maven-surefire-plugin.version>3.6.0</maven-surefire-plugin.version>
    <maven-failsafe-plugin.version>3.6.0</maven-failsafe-plugin.version>

    <!--
      Single source of truth for the PostgreSQL major version used across the build (ADR-0015 rule
      1; design.md decision 3): both the jOOQ code-generation plugin (app/pom.xml, generate-sources)
      and PostgresIntegrationTest read this same property, never a second literal.
    -->
    <confia.postgres.image>postgres:18-alpine</confia.postgres.image>

    <!--
      jOOQ code generation over a Testcontainers-managed PostgreSQL (ADR-0015 rule 2; design.md
      decision 1, route A; S1 probe, apply-progress.md task 1.1). Version declared here because the
      Spring Boot 4.1.1 BOM's own pluginManagement is never inherited: apps/api/pom.xml imports the
      BOM as a <dependency> (scope import), not as a Maven <parent>, so pluginManagement entries in
      an imported BOM never apply (design.md section 2). The plugin itself still pins its own
      Testcontainers 1.19.1 and jOOQ 3.18.3 dependencies regardless of this version; app/pom.xml's
      execution (task 1.7) overrides those inside <plugin><dependencies> to match the versions this
      reactor actually uses everywhere else (S1 probe: 1.19.1 cannot reach Docker Desktop on this
      machine, and 3.18.3 cannot introspect a PostgreSQL 18 catalog).
    -->
    <testcontainers-jooq-codegen-maven-plugin.version>0.0.4</testcontainers-jooq-codegen-maven-plugin.version>

    <!-- Java 25 support confirmed against release notes: jacoco.org/jacoco/trunk/doc/changes.html,
         "Release 0.8.14 (2025/10/11)", "JaCoCo now officially supports Java 25". -->
    <jacoco-maven-plugin.version>0.8.14</jacoco-maven-plugin.version>
    <pitest-maven.version>1.30.0</pitest-maven.version>
    <pitest-junit5-plugin.version>1.2.3</pitest-junit5-plugin.version>
    <!-- jqwik: test-scope only in kernel (ADR-0013; enforce-kernel-purity only bans
         compile/runtime/provided/system, so this does not need an exclusion there). Not managed by
         the Spring Boot BOM. -->
    <jqwik.version>1.10.1</jqwik.version>
    <!-- bcprov-jdk18on (design.md decision 6; sonda S2, apply-progress.md): Argon2id via Bouncy
         Castle directly, compile-scoped in app/pom.xml, because Argon2Parameters.Builder is the
         only one of the two candidate APIs that exposes withSecret(byte[]) — confirmed by javap
         against both spring-security-crypto 7.0.0 and bcprov-jdk18on 1.81. Spring's own encoder
         compiles against these same three Bouncy Castle classes anyway and declares the dependency
         nowhere, so going through Spring would cost two artifacts instead of one and still not
         reach the pepper. Not managed by the Spring Boot BOM. -->
    <!-- 1.86, and not the 1.81 this dependency first arrived as. The dependency-vulnerability gate
         (docs/03-seguridad.md; build-integrity "Vulnerabilidad alta o crítica rompe la construcción")
         rejected 1.81 with three findings: CVE-2025-14813 and CVE-2026-8763 critical, CVE-2026-13506
         high. The advisory database gives 1.85 as the first release patching all four known high and
         critical advisories for this artifact — the fourth being CVE-2026-5598, patched in 1.84 —
         and Trivy's own table left CVE-2026-13506's fixed version blank, so the version was chosen
         from the advisories rather than from that table. 1.86 is the latest release and is above
         every one of those thresholds. -->
    <bcprov-jdk18on.version>1.86</bcprov-jdk18on.version>

    <!-- springdoc-openapi (frontend-monorepo-and-contracts-pipeline, design.md decisions 1 to 3;
         probe S1, apply-progress.md task 1.1): 3.1.1 is the release built against Spring Boot
         4.1.0 (its parent is spring-boot-starter-parent 4.1.0, read from the published POM), the
         line this build runs on. Not managed by the Spring Boot BOM. -->
    <springdoc.version>3.1.1</springdoc.version>

    <!-- confia.pit.phase=none: PIT never runs on a plain ./mvnw verify with no profile active
         (design.md, decision 9). The mutation-report and mutation-gate profiles below rebind it to
         verify and choose the effective threshold; declared in this order on purpose so that
         mutation-gate, declared last, wins if both profiles are ever active at once (decision 10). -->
    <confia.pit.phase>none</confia.pit.phase>
    <confia.pit.mutationThreshold>80</confia.pit.mutationThreshold>
    <confia.pit.effectiveThreshold>${confia.pit.mutationThreshold}</confia.pit.effectiveThreshold>
  </properties>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-dependencies</artifactId>
        <version>${spring-boot.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <dependency>
        <groupId>org.springframework.modulith</groupId>
        <artifactId>spring-modulith-bom</artifactId>
        <version>${spring-modulith.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <!--
        verify-report.md W6: app/pom.xml declares archunit-junit5 at ${archunit.version} (1.5.0),
        but archunit-junit5-api and archunit-junit5-engine (both 1.5.0) each transitively require
        the plain "archunit" core artifact at 1.5.0 too, while spring-modulith-core:2.1.1 depends
        directly on "archunit" 1.4.2 at a shallower depth. Maven's nearest-wins mediation silently
        resolves the core artifact to 1.4.2 (confirmed with `./mvnw -X`) despite no property ever
        saying so, and DependencyConvergence does not flag it. Declaring the version here, matching
        what mediation already resolves, makes the declaration true instead of an invisible
        mediation outcome. Not raised to 1.5.0: the "archunit" 1.5.0 jar itself never downloaded
        into the local repository on this machine (only its POM did; a Windows PKIX trust-store gap
        blocks new Maven Central downloads here), while 1.4.2 is already cached and is the version
        every test in this module has actually run against since the original apply batch.
      -->
      <dependency>
        <groupId>com.tngtech.archunit</groupId>
        <artifactId>archunit</artifactId>
        <version>1.4.2</version>
        <scope>test</scope>
      </dependency>
      <!--
        jqwik: property-based testing for kernel (design.md decision 5 of the proposal; ADR-0004
        §Cumplimiento 6). Not part of the Spring Boot BOM, so it is managed here explicitly. Its own
        transitive junit-platform-* dependencies are overridden by junit-bom (imported above through
        spring-boot-dependencies) at 6.0.3, which is what keeps enforcer's dependencyConvergence
        rule green.
      -->
      <dependency>
        <groupId>net.jqwik</groupId>
        <artifactId>jqwik</artifactId>
        <version>${jqwik.version}</version>
        <scope>test</scope>
      </dependency>
      <!--
        bcprov-jdk18on (design.md decision 6, sonda S2): Argon2id with the pepper applied as
        Argon2Parameters.Builder#withSecret(byte[]), which spring-security-crypto's
        Argon2PasswordEncoder does not expose. Compile scope in app/pom.xml: this dependency is a
        production dependency of com.confia.identity.infrastructure, not a test-only tool.
      -->
      <dependency>
        <groupId>org.bouncycastle</groupId>
        <artifactId>bcprov-jdk18on</artifactId>
        <version>${bcprov-jdk18on.version}</version>
      </dependency>
      <!-- OpenAPI 3.1 generation and, only on the local and preprod profiles, Swagger UI
           (docs/01-arquitectura.md §7; frontend-monorepo-and-contracts-pipeline, design.md
           decisions 1 to 3). -->
      <dependency>
        <groupId>org.springdoc</groupId>
        <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
        <version>${springdoc.version}</version>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <build>
    <pluginManagement>
      <plugins>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-compiler-plugin</artifactId>
          <version>${maven-compiler-plugin.version}</version>
          <configuration>
            <release>${maven.compiler.release}</release>
          </configuration>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-surefire-plugin</artifactId>
          <version>${maven-surefire-plugin.version}</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-failsafe-plugin</artifactId>
          <version>${maven-failsafe-plugin.version}</version>
          <configuration>
            <!-- Carries the integration-phase JaCoCo agent (jacoco-prepare-agent-integration). -->
            <argLine>@{failsafeArgLine}</argLine>
          </configuration>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-enforcer-plugin</artifactId>
          <version>${maven-enforcer-plugin.version}</version>
        </plugin>
        <!--
          jOOQ code generation plugin (ADR-0015 rule 2; design.md decision 1). Version only: each
          module that generates code (today, only app) declares its own <configuration> and its own
          <dependencies> override for the plugin's pinned Testcontainers/jOOQ versions (task 1.7).
        -->
        <plugin>
          <groupId>org.testcontainers</groupId>
          <artifactId>testcontainers-jooq-codegen-maven-plugin</artifactId>
          <version>${testcontainers-jooq-codegen-maven-plugin.version}</version>
        </plugin>
        <!--
          Coverage gate (docs/06 §14.1). Version and generic executions managed here; each module
          that wants the check binds its own jacoco:check execution with its own thresholds
          (design.md, decision 8), so today only kernel opts in and app is not held to 95 % before
          change 4 introduces its own domain packages and global 80 % rule.
        -->
        <plugin>
          <groupId>org.jacoco</groupId>
          <artifactId>jacoco-maven-plugin</artifactId>
          <version>${jacoco-maven-plugin.version}</version>
          <executions>
            <!--
              Unit and integration coverage are collected into SEPARATE files and merged before the
              report (task 1.7 of this change found the earlier single-file setup broken in both
              directions). Surefire and Failsafe fork their own JVMs within one `mvn verify`, each
              carrying an agent: writing both to one file with append=false made whichever flushed
              last truncate the other's data, and append=true let a stale file from an earlier,
              narrower run satisfy the gate without an intervening `clean` (verify report W3 of
              kernel-money-value-object). One file per phase, each truncated at the start of its own
              run, then merged, has neither problem: the gate always measures exactly this build's
              unit plus integration coverage, which is what docs/06 line 611 asks for.
            -->
            <execution>
              <id>jacoco-prepare-agent</id>
              <goals>
                <goal>prepare-agent</goal>
              </goals>
              <configuration>
                <destFile>${project.build.directory}/jacoco-ut.exec</destFile>
                <append>false</append>
              </configuration>
            </execution>
            <execution>
              <id>jacoco-prepare-agent-integration</id>
              <goals>
                <goal>prepare-agent-integration</goal>
              </goals>
              <configuration>
                <destFile>${project.build.directory}/jacoco-it.exec</destFile>
                <append>false</append>
                <propertyName>failsafeArgLine</propertyName>
              </configuration>
            </execution>
            <execution>
              <id>jacoco-merge</id>
              <phase>verify</phase>
              <goals>
                <goal>merge</goal>
              </goals>
              <configuration>
                <fileSets>
                  <fileSet>
                    <directory>${project.build.directory}</directory>
                    <includes>
                      <include>jacoco-ut.exec</include>
                      <include>jacoco-it.exec</include>
                    </includes>
                  </fileSet>
                </fileSets>
                <destFile>${project.build.directory}/jacoco.exec</destFile>
              </configuration>
            </execution>
            <execution>
              <id>jacoco-report</id>
              <phase>verify</phase>
              <goals>
                <goal>report</goal>
              </goals>
            </execution>
          </executions>
        </plugin>
        <!--
          Mutation gate (docs/06 §14.1, design.md decisions 9 and 10). Declared once here with the
          plugin dependency on pitest-junit5-plugin (required from its 1.2 line on, which stopped
          bundling junit-platform-launcher, itself added to kernel's test scope in task 1.3) and a
          single mutationCoverage execution whose phase and threshold come from properties. Each
          module that wants PIT declares this plugin in its own <plugins> with its own
          targetClasses/targetTests (decision 9); app does not declare it, so PIT never runs there
          until change 4.
        -->
        <plugin>
          <groupId>org.pitest</groupId>
          <artifactId>pitest-maven</artifactId>
          <version>${pitest-maven.version}</version>
          <dependencies>
            <dependency>
              <groupId>org.pitest</groupId>
              <artifactId>pitest-junit5-plugin</artifactId>
              <version>${pitest-junit5-plugin.version}</version>
            </dependency>
          </dependencies>
          <configuration>
            <mutators>
              <mutator>STRONGER</mutator>
            </mutators>
            <threads>2</threads>
            <timestampedReports>false</timestampedReports>
            <outputFormats>
              <outputFormat>HTML</outputFormat>
              <outputFormat>XML</outputFormat>
            </outputFormats>
            <failWhenNoMutations>true</failWhenNoMutations>
            <mutationThreshold>${confia.pit.effectiveThreshold}</mutationThreshold>
          </configuration>
          <executions>
            <execution>
              <id>pit-mutation</id>
              <phase>${confia.pit.phase}</phase>
              <goals>
                <goal>mutationCoverage</goal>
              </goals>
            </execution>
          </executions>
        </plugin>
      </plugins>
    </pluginManagement>

    <plugins>
      <!--
        Failsafe wired now, on an empty integration-test suite, so no module ever needs to touch
        this block again to gain *IT.java coverage (design.md, testing strategy, "Integración").
      -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-failsafe-plugin</artifactId>
        <executions>
          <execution>
            <goals>
              <goal>integration-test</goal>
              <goal>verify</goal>
            </goals>
          </execution>
        </executions>
      </plugin>

      <!--
        maven-enforcer-plugin, bound to validate (docs/06 §14.1): fails the build before compiling
        anything if the Java version drifts, dependencies do not converge, or a banned dependency
        appears anywhere in apps/api. Per requirement "Ninguna regla se desactiva sin un ADR": any
        exclusion added later to this execution MUST cite the authorizing ADR in a comment next to
        it. No exclusion exists today.
      -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-enforcer-plugin</artifactId>
        <executions>
          <execution>
            <id>enforce-build-integrity</id>
            <phase>validate</phase>
            <goals>
              <goal>enforce</goal>
            </goals>
            <configuration>
              <rules>
                <requireJavaVersion>
                  <version>[25,26)</version>
                </requireJavaVersion>
                <dependencyConvergence/>
                <!--
                  Banned dependencies (ADR-0015: persistence; ADR-0016: task scheduling). The
                  PostgreSQL JDBC driver and the JDK's own java.sql are NOT banned: jOOQ and the
                  transactional component depend on them.
                -->
                <bannedDependencies>
                  <excludes>
                    <exclude>org.hibernate:*</exclude>
                    <exclude>org.hibernate.orm:*</exclude>
                    <exclude>jakarta.persistence:*</exclude>
                    <exclude>javax.persistence:*</exclude>
                    <exclude>org.springframework.data:spring-data-jpa</exclude>
                    <exclude>org.springframework.data:spring-data-jdbc</exclude>
                    <exclude>org.quartz-scheduler:*</exclude>
                    <exclude>org.jobrunr:*</exclude>
                    <!-- Spring Security is used only as a servlet filter chain: no OAuth2 resource
                         server, no JWT decoding. Authentication belongs to the opaque session
                         tokens of the session change (web-edge-foundations design.md, decision
                         4). The two artifacts named here are the resource server itself, by the
                         starter and by the library. -->
                    <exclude>org.springframework.boot:spring-boot-starter-oauth2-resource-server</exclude>
                    <exclude>org.springframework.security:spring-security-oauth2-resource-server</exclude>
                    <!-- No JOSE or JWT library of any kind: the administrative token is an
                         in-house compact JWS over the JDK's own Ed25519 (owner decision DA-2,
                         session-tokens-and-web-layer design.md decision 2). Nimbus JOSE, Tink,
                         jjwt and java-jwt, by groupId (and artifact where the group is wider). -->
                    <exclude>com.nimbusds:*</exclude>
                    <exclude>com.google.crypto.tink:*</exclude>
                    <exclude>io.jsonwebtoken:*</exclude>
                    <exclude>com.auth0:java-jwt</exclude>
                  </excludes>
                  <message>
                    Banned dependency (ADR-0015 forbids Hibernate/JPA/Spring Data JPA/Spring Data
                    JDBC; ADR-0016 forbids Quartz/JobRunr and other task schedulers;
                    web-edge-foundations design.md decision 4 keeps Spring Security a servlet
                    filter chain and forbids the OAuth2 resource server; owner decision DA-2
                    forbids Nimbus JOSE, Tink, jjwt and java-jwt because tokens are signed by the
                    in-house JWS codec of shared.security.token). Adding a new scheduler,
                    persistence library or authentication stack to this list requires a new ADR,
                    never a silent exclusion here.
                  </message>
                </bannedDependencies>
              </rules>
              <fail>true</fail>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>

  <profiles>
    <!--
      SNAPSHOT ban, main branch only (design.md decision 2). The enforcer plugin has no concept of
      Git branches, so the CI workflow (.github/workflows/ci.yml) activates this profile only when
      building `main`, by passing -Dconfia.ci.mainBranch=true to `./mvnw verify`. A working branch
      never sets that property and may carry a punctual SNAPSHOT dependency; `main` never may.
      The rule bans SNAPSHOT dependencies only, not the project's own version: apps/api is never
      published, stays at x.y.z-SNAPSHOT on every branch, and reaches `main` unchanged through
      merges, so requireReleaseVersion made `main` permanently red (CI run 35298912884).
    -->
    <profile>
      <id>no-snapshots-on-main</id>
      <activation>
        <property>
          <name>confia.ci.mainBranch</name>
          <value>true</value>
        </property>
      </activation>
      <build>
        <plugins>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-enforcer-plugin</artifactId>
            <executions>
              <execution>
                <id>enforce-no-snapshots-on-main</id>
                <phase>validate</phase>
                <goals>
                  <goal>enforce</goal>
                </goals>
                <configuration>
                  <rules>
                    <requireReleaseDeps>
                      <message>
                        main never depends on a SNAPSHOT dependency (design.md decision 2).
                      </message>
                      <!-- The reactor's own parent and sibling modules share its SNAPSHOT
                           version by design; only external dependencies are checked. -->
                      <failWhenParentIsSnapshot>false</failWhenParentIsSnapshot>
                      <excludes>
                        <exclude>com.confia:*</exclude>
                      </excludes>
                    </requireReleaseDeps>
                  </rules>
                  <fail>true</fail>
                </configuration>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>

    <!--
      Mutation profiles (design.md decisions 9, 10 and 11; docs/06 §14.1). Both only set the two
      properties that pitest-maven's managed execution above reads: which phase runs PIT and which
      mutation score fails the build. mutation-report is declared FIRST and mutation-gate SECOND on
      purpose: Maven injects active profile properties in POM declaration order and the last one
      wins, so if both are ever active at the same time (for example
      "-Pmutation-report -Dconfia.ci.mainBranch=true"), mutation-gate wins and the build blocks.
      Confirmed with `mvn help:evaluate -Dexpression=confia.pit.effectiveThreshold` in task 1.13.
    -->
    <profile>
      <!-- Explicit only: never activates on a plain ./mvnw verify, which would force every local
           run to download and execute PIT (see "Restricciones del entorno local" in design.md). -->
      <id>mutation-report</id>
      <properties>
        <confia.pit.phase>verify</confia.pit.phase>
        <confia.pit.effectiveThreshold>0</confia.pit.effectiveThreshold>
      </properties>
    </profile>
    <profile>
      <!-- Declared last: wins over mutation-report when both are active. Activates the same way as
           no-snapshots-on-main, with -Pmutation-gate as an explicit alternative. -->
      <id>mutation-gate</id>
      <activation>
        <property>
          <name>confia.ci.mainBranch</name>
          <value>true</value>
        </property>
      </activation>
      <properties>
        <confia.pit.phase>verify</confia.pit.phase>
        <confia.pit.effectiveThreshold>${confia.pit.mutationThreshold}</confia.pit.effectiveThreshold>
      </properties>
    </profile>
  </profiles>
</project>
